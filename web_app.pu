            </div>
            <div class="stat red">
                <div class="value" id="losses">{{ stats.losses }}</div>
                <div class="label">❌ Проигрыши</div>
            </div>
            <div class="stat gold">
                <div class="value" id="profit">${{ stats.total_profit }}</div>
                <div class="label">💰 Прибыль</div>
            </div>
        </div>
        
        <div class="card">
            <div class="header-row">
